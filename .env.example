# Local Docker/VPS example. Do not commit real credentials.
APP_ENV=production
STORAGE_BACKEND=local
DOMAIN=sign.example.com
POSTGRES_DB=securesign
POSTGRES_USER=securesign
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_-hex_32
DATABASE_URL=postgresql+psycopg://securesign:REPLACE_PASSWORD@db:5432/securesign
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
ADMIN_RESET_PASSWORD=false
ADMIN_NAME=SecureSign Administrator
SESSION_TTL_HOURS=12
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_BASE_URL=https://sign.example.com
ALLOWED_ORIGINS=https://sign.example.com
SECURESIGN_MAX_UPLOAD_BYTES=4194304

# Configure either Resend API or SMTP. Resend is recommended for Vercel.
RESEND_API_KEY=
SMTP_FROM=SecureSign <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Required for production shared rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# For Vercel, set STORAGE_BACKEND=vercel_blob and connect a PRIVATE Blob store.
# Vercel injects BLOB_STORE_ID / OIDC credentials when the store is connected.
