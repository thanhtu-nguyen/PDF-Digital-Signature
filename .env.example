# Copy this file to .env and replace every placeholder before deployment.
DOMAIN=sign.example.com
POSTGRES_DB=securesign
POSTGRES_USER=securesign
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_-hex_32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
ADMIN_RESET_PASSWORD=false
ADMIN_NAME=SecureSign Administrator
SESSION_TTL_HOURS=12
REQUIRE_EMAIL_VERIFICATION=true
ALLOWED_ORIGINS=
SECURESIGN_MAX_UPLOAD_BYTES=26214400

# SMTP is required for public registration email verification and password resets.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="SecureSign <no-reply@example.com>"
SMTP_STARTTLS=true
